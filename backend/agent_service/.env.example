# DeepSeek example. Put the real API key only in the ignored local .env file.
AGENT_MODEL_BASE_URL=https://api.deepseek.com
AGENT_MODEL_NAME=deepseek-flash
AGENT_MODEL_API_KEY=

# chat_completions: OpenAI-compatible third-party APIs.
# responses: OpenAI Responses API or a verified compatible endpoint.
AGENT_MODEL_API=chat_completions

# Local-only bridge. The Flutter app calls Serverpod, not this port.
AGENT_PORT=8093
